# Секреты заполняются в настройках Bothost, не в GitHub.
BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Без завершающего слеша. В Spotify Redirect URI: https://ваш-домен/oauth/spotify
PUBLIC_BASE_URL=https://your-bot.bothost.ru
# Получить командой: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Необязательно: ограничить доступ указанными Telegram ID. Пустое значение — доступ всем.
ALLOWED_TELEGRAM_IDS=
# Нужен для реальной классификации, без него работает /demo.
LASTFM_API_KEY=
PORT=3000
# Для Bothost установите /app/data
DATA_DIR=./data
# Первые 300 лайков на время теста; увеличить после проверки качества.
SCAN_LIMIT=300
