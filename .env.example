# Секреты заполняются в настройках Bothost, не в GitHub.
BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Без завершающего слеша. В Spotify Redirect URI: https://ваш-домен/oauth/spotify
PUBLIC_BASE_URL=https://your-bot.bothost.ru
# Получить командой: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Необязательно: ограничить доступ указанными Telegram ID. Пустое значение — доступ всем.
ALLOWED_TELEGRAM_IDS=
# Нужен для реальной классификации, без него работает /demo.
LASTFM_API_KEY=
PORT=3000
# Для Bothost установите /app/data
DATA_DIR=./data
# Первые 300 лайков на время теста; увеличить после проверки качества.
SCAN_LIMIT=1000
# Фото: ключ Provod AI вводится только в панели хостинга.
PROVOD_API_KEY=
AI_BASE_URL=https://api.provod.ai/v1
# Нужна модель с поддержкой изображений; проверь доступность в Provod.
AI_VISION_MODEL=gpt-4o-mini
# Необязательно: отдельная модель для резервного определения жанров/вайба.
# По умолчанию используется AI_VISION_MODEL, запросы расходуют баланс Provod.
AI_TAG_MODEL=
# Необязательно: для импорта публичных YouTube / YouTube Music плейлистов.
# Ключ проекта Google с включённым YouTube Data API v3; не OAuth и не ключ Provod.
YOUTUBE_API_KEY=
